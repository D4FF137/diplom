FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS base
WORKDIR /app
EXPOSE 5004

FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

# Copy shared projects
COPY ["shared/Common/Common.csproj", "shared/Common/"]
COPY ["shared/Models/Models.csproj", "shared/Models/"]
COPY ["shared/Contracts/Contracts.csproj", "shared/Contracts/"]

# Copy ChatService project
COPY ["src/ChatService/ChatService.csproj", "src/ChatService/"]

# Restore dependencies
RUN dotnet restore "src/ChatService/ChatService.csproj"

# Copy everything else and build
COPY . .
WORKDIR "/src/src/ChatService"
RUN dotnet build "ChatService.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "ChatService.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
RUN apk add --no-cache curl icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "ChatService.dll"]


