FROM mcr.microsoft.com/dotnet/aspnet:8.0-alpine AS base
WORKDIR /app
EXPOSE 5003

FROM mcr.microsoft.com/dotnet/sdk:8.0-alpine AS build
WORKDIR /src

# Copy shared projects
COPY ["shared/Common/Common.csproj", "shared/Common/"]
COPY ["shared/Models/Models.csproj", "shared/Models/"]
COPY ["shared/Contracts/Contracts.csproj", "shared/Contracts/"]

# Copy FeedService project
COPY ["src/FeedService/FeedService.csproj", "src/FeedService/"]

# Restore dependencies
RUN dotnet restore "src/FeedService/FeedService.csproj"

# Copy everything else and build
COPY . .
WORKDIR "/src/src/FeedService"
RUN dotnet build "FeedService.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "FeedService.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
RUN apk add --no-cache curl icu-libs
ENV DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "FeedService.dll"]


