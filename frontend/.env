# API (через Caddy reverse-proxy на :80)
VITE_API_URL=http://localhost/api

# WebSocket-хабы — тоже через Caddy на :80 (он терминирует WS upgrade и проксирует в нужный сервис)
VITE_WS_URL=http://localhost
VITE_FEED_WS_URL=http://localhost
VITE_NOTIFICATION_WS_URL=http://localhost

# Секрет админ-панели — тот же, что ADMIN_SECRET в backend/.env и при docker compose
VITE_ADMIN_SECRET=supersecretadminsecret
